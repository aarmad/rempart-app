# Copier ce fichier en .env et adapter les noms d'exemple.
# Renseigner deux mots de passe locaux différents. Le .env est ignoré par Git.

# Superutilisateur PostgreSQL : initialisation et migrations.
POSTGRES_USER=exemple_admin
POSTGRES_DB=exemple_rempart
POSTGRES_PASSWORD=""

# Compte applicatif au moindre privilège.
APP_DB_USER=exemple_app
APP_DB_PASSWORD=""

# Clé de chiffrement TOTP locale, 32 octets sous forme hexadécimale (openssl rand -hex 32).
TOTP_ENC_KEY=""

# Adresse de contact confidentialité de l'équipe qui exploite l'instance (facultative en local).
PRIVACY_CONTACT_EMAIL=""
