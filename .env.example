# Copie ce fichier en .env puis mets de vraies valeurs.
# .env est ignore par git : il ne doit JAMAIS etre pousse.

# Superutilisateur postgres : init/migrations uniquement.
POSTGRES_USER=rempart
POSTGRES_PASSWORD=remplace_par_un_secret_fort
POSTGRES_DB=rempart

# Compte applicatif au moindre privilege : utilise par l'app.
APP_DB_USER=rempart_app
APP_DB_PASSWORD=remplace_par_un_autre_secret_fort

# Cookie de session Secure : false en local (http), true en prod (HTTPS).
COOKIE_SECURE=false

# Cle (hex 64 = 32 octets) pour chiffrer les secrets TOTP au repos (AES-256-GCM).
TOTP_ENC_KEY=remplace_par_32_octets_en_hex_64_caracteres
